# release, as recorded in the design document (Section 16).
repository-code: "https://github.com/OWNER/camsim"
url: "https://github.com/OWNER/camsim"
keywords:
  - camera simulation
  - image quality
  - image quality metrics
  - image signal processor
  - sensor modelling
  - radiometry
  - colorimetry
  - reproducible research
